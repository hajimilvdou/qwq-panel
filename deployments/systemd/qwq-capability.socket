# SPDX-License-Identifier: AGPL-3.0-only
# 独立能力 socket：仅 root/qwq 可连接，插件动态用户不能直接触达。
[Unit]
Description=qwq host capability socket
Documentation=https://github.com/qwq-panel/qwq

[Socket]
ListenStream=/run/qwq/capability.sock
SocketMode=0660
SocketGroup=qwq
Service=qwq-capability.service
RemoveOnStop=yes
TriggerLimitIntervalSec=2
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
