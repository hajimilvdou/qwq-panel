{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "更新门户注册与额度策略请求",
  "description": "部分或全量更新注册通道开关、LinuxDo OAuth2 信任分级、SMTP 发信配置与签到补水策略。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site_title": { "type": "string", "minLength": 1, "maxLength": 80, "description": "门户站点标题。" },
    "site_announcement": { "type": "string", "maxLength": 512, "description": "门户顶部公告文本。" },
    "allow_invite_signup": { "type": "boolean", "description": "是否开启邀请码注册。" },
    "allow_email_signup": { "type": "boolean", "description": "是否开启邮箱验证码注册。" },
    "email_domain_allowlist": {
      "type": "array",
      "maxItems": 64,
      "description": "邮箱域名白名单列表。",
      "items": { "type": "string", "minLength": 3, "maxLength": 128 }
    },
    "allow_linuxdo_signup": { "type": "boolean", "description": "是否开启 LinuxDo OAuth2 注册。" },
    "linuxdo_client_id": { "type": "string", "maxLength": 128, "description": "LinuxDo OAuth2 Client ID。" },
    "linuxdo_client_secret": {
      "type": "string",
      "maxLength": 256,
      "x-secret": true,
      "writeOnly": true,
      "description": "LinuxDo OAuth2 Client Secret（留空表示保持原加密凭据不变）。"
    },
    "linuxdo_min_trust_level": { "type": "integer", "minimum": 0, "maximum": 4, "description": "最低允许注册 LinuxDo 信任等级（0..4）。" },
    "linuxdo_tier_rules": { "type": "object", "description": "按 trust_level 0..4 映射的分组、初始微点与日回血上限。" },
    "default_signup_micros": { "type": "integer", "minimum": 0, "description": "默认注册赠额（micros）。" },
    "inviter_reward_micros": { "type": "integer", "minimum": 0, "description": "邀请人奖励微点。" },
    "invitee_reward_micros": { "type": "integer", "minimum": 0, "description": "受邀人奖励微点。" },
    "max_invite_rewards_per_user": { "type": "integer", "minimum": 0, "maximum": 1000, "description": "每用户最大邀请奖励次数。" },
    "checkin_enabled": { "type": "boolean", "description": "是否启用每日签到补水。" },
    "checkin_min_micros": { "type": "integer", "minimum": 0, "description": "签到最低发放微点。" },
    "checkin_max_micros": { "type": "integer", "minimum": 0, "description": "签到最高发放微点。" },
    "checkin_drip_below_micros": { "type": "integer", "minimum": 0, "description": "低余额水龙头门槛（micros，0 表示不限制余额）。" },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选 SMTP 发信配置，加密后存入本地库。",
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253, "description": "SMTP 服务器地址。" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "SMTP 端口。" },
        "username": { "type": "string", "maxLength": 128, "description": "SMTP 登录用户名。" },
        "password": {
          "type": "string",
          "maxLength": 256,
          "x-secret": true,
          "writeOnly": true,
          "description": "SMTP 登录密码或授权码。"
        },
        "from_address": { "type": "string", "maxLength": 128, "description": "发件人邮箱地址。" }
      }
    }
  }
}
