      "name": "docker.stat.containers",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "运行中与总容器数量概览",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/stat.response.json"
    },
    {
      "name": "docker.checks.health",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 8000,
      "summary": "全部容器运行与健康状态检查列表",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/checks.response.json"
    },
    {
      "name": "docker.overview",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 10000,
      "ui_route": "/containers",
      "summary": "查看 Docker 守护进程状态、容器列表、本地镜像与受管 Compose 栈",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        },
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/docker.overview.response.json"
    },
    {
      "name": "docker.ai.digest",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 8000,
      "summary": "输出低于 2KiB 的容器异常、OOM 与退出口摘要供原生 AI 排查",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        },
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/docker.ai.digest.response.json"
    },
    {
      "name": "docker.container.inspect",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 10000,
      "summary": "查询单个容器详情、实时 CPU/内存占用与 OOMKilled 状态",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.id.request.json",
      "response_schema": "schemas/docker.container.inspect.response.json"
    },
    {
      "name": "docker.container.logs",
      "api_version": "v1",
      "permission": "containers.docker:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 10000,
      "summary": "读取容器最近 N 行有界日志（上限 500 行 / 64 KiB）",
      "capabilities": [
        {
          "name": "system.docker.read",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.container.logs.request.json",
      "response_schema": "schemas/docker.container.logs.response.json"
    },
    {
      "name": "docker.container.action",
      "api_version": "v1",
      "permission": "containers.docker:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": false,
      "timeout_ms": 30000,
      "approval": "ai_confirm",
      "approval_summary": "启动、停止或重启 Docker 容器",
      "approval_description": "对指定容器执行 start / stop / restart 生命周期控制。",
      "summary": "执行容器启动、停止或重启",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.container.action.request.json",
      "response_schema": "schemas/docker.container.action.response.json"
    },
    {
      "name": "docker.container.limits",
      "api_version": "v1",
      "permission": "containers.docker:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 15000,
      "approval": "ai_confirm",
      "approval_summary": "调整运行中容器的内存或 CPU 上限",
      "approval_description": "通过 Docker Engine /update 接口实时更新容器 cgroup 内存与 CPU 限额，防止小鸡被单个容器 OOM 拖垮。",
      "summary": "动态更新容器内存与 CPU 资源限额",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.container.limits.request.json",
      "response_schema": "schemas/docker.container.limits.response.json"
    },
    {
      "name": "docker.container.remove",
      "api_version": "v1",
      "permission": "containers.docker:delete",
      "mode": "invoke",
      "effect": "destructive",
      "risk": "high",
      "idempotent": true,
      "timeout_ms": 15000,
      "approval": "confirm",
      "approval_summary": "删除指定 Docker 容器",
      "approval_description": "不可逆移除容器及其可写层数据（数据卷不会自动删除）。",
      "summary": "删除指定 Docker 容器",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.container.remove.request.json",
      "response_schema": "schemas/docker.container.remove.response.json"
    },
    {
      "name": "docker.images.prune",
      "api_version": "v1",
      "permission": "containers.docker:delete",
      "mode": "invoke",
      "effect": "destructive",
      "risk": "high",
      "idempotent": true,
      "timeout_ms": 60000,
      "approval": "confirm",
      "approval_summary": "清理无用 Docker 镜像释放磁盘空间",
      "approval_description": "删除未被任何容器引用的悬空或闲置镜像，释放 VPS 磁盘空间。",
      "summary": "清理未使用的 Docker 镜像并报告释放空间",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        }
      ],
      "request_schema": "schemas/docker.images.prune.request.json",
      "response_schema": "schemas/docker.images.prune.response.json"
    },
    {
      "name": "docker.compose.deploy",
      "api_version": "v1",
      "permission": "containers.docker:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "high",
      "idempotent": true,
      "plannable": true,
      "timeout_ms": 90000,
      "approval": "confirm",
      "approval_summary": "安全扫描并部署 Compose 编排栈",
      "approval_description": "对 compose.yml 进行特权/宿主机挂载风险扫描，原子保存并执行 docker compose up -d。",
      "summary": "校验、保存并部署 Docker Compose 编排栈",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        },
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/docker.compose.deploy.request.json",
      "response_schema": "schemas/docker.compose.deploy.response.json"
    },
    {
      "name": "docker.compose.remove",
      "api_version": "v1",
      "permission": "containers.docker:delete",
      "mode": "invoke",
      "effect": "destructive",
      "risk": "high",
      "idempotent": true,
      "timeout_ms": 45000,
      "approval": "confirm",
      "approval_summary": "停止并移除 Compose 编排栈",
      "approval_description": "执行 docker compose down 并删除该编排栈记录及工作目录中的 compose.yml。",
      "summary": "停止并删除指定 Compose 编排栈",
      "capabilities": [
        {
          "name": "system.docker.manage",
          "scope": "local"
        },
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/docker.compose.remove.request.json",
      "response_schema": "schemas/docker.compose.remove.response.json"
    }
  ],
  "capabilities": [
    {
      "name": "system.docker.read",
      "scope": "local",
      "reason": "通过只读 Unix Socket 接口查询容器状态、实时资源占用、OOM 标记与有界日志"
    },
    {
      "name": "system.docker.manage",
      "scope": "local",
      "reason": "在审批通过后执行容器启停、动态资源限额更新、镜像清理与受管 Compose 编排"
    },
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取已保存的受管 Compose 编排栈清单与安全告警"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "持久化受管 Compose 编排栈定义与版本元数据"
    }
  ],
  "dependencies": [],
  "state": {
    "schema_version": "1",
    "minimum_rollback_version": "0.1.0",
    "backup_paths": [
      "docker.db",
      "stacks"
    ]
  },
  "config": {
    "schema": "schemas/config.schema.json",
    "hot_apply": true
  },
  "resources": {
    "memory_max_mb": 32,
    "cpu_quota_percent": 15,
    "pids_max": 24,
    "fds_max": 256,
    "disk_max_mb": 128,
    "kv_max_kb": 256
  },
  "ui": {
    "widgets": [
      {
        "id": "containers",
        "title": "Docker 容器",
        "kind": "stat",
        "operation": "docker.stat.containers",
        "refresh_seconds": 10,
        "size": "s",
        "color": "cyan"
      },
      {
        "id": "health",
        "title": "容器健康状态",
        "kind": "checks",
        "operation": "docker.checks.health",
        "refresh_seconds": 15,
        "size": "m",
        "color": "blue"
      }
    ],
    "entry": "ui/index.html",
    "sandbox": true,
    "connect_sources": [],
    "routes": [
      {
        "path": "/containers",
        "title": "容器编排",
        "nav": true,
        "permission": "containers.docker:read"
      }
    ]
  }
}
