{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "memory_mb": {
      "type": "integer",
      "minimum": 16,
      "maximum": 65536
    },
    "cpus": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 64
    },
    "restart_policy": {
      "type": "string",
      "enum": [
        "no",
        "on-failure",
        "unless-stopped",
        "always"
      ]
    },
    "restart_max_retry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
