{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qwq:plugin:core.xray:config:v2",
  "title": "Core Intent v1/v2",
  "description": "完整期望快照；支持 Core Intent v1（单 VLESS REALITY 入站）与 Core Intent v2（多 profile：VLESS / VMess / Trojan / Shadowsocks / Shadowsocks-2022 / Hysteria2 / AnyTLS / SOCKS5 / HTTP）。字段间一致性与协议细则由 Go 语义校验强制。",
  "oneOf": [
    {
      "$ref": "#/$defs/intentV1"
    },
    {
      "$ref": "#/$defs/intentV2"
    }
  ],
  "$defs": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$secret": {
          "type": "string",
          "pattern": "^sec_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "minLength": 30,
          "maxLength": 30
        }
      },
      "required": [
        "$secret"
      ]
    },
    "secretValue128": {
      "x-secret": true,
      "writeOnly": true,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "$ref": "#/$defs/secretRef"
        }
      ]
    },
    "secretValue256": {
      "x-secret": true,
      "writeOnly": true,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "$ref": "#/$defs/secretRef"
        }
      ]
    },
    "listenAddr": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45,
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "tlsBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "server_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        }
      },
      "required": [
        "binding_ref",
        "server_name"
      ]
    },
    "realitySecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "reality"
        },
        "target": {
          "type": "string",
          "minLength": 3,
          "maxLength": 259,
          "description": "合法 DNS 名或 IP 加明确端口；DNS/IP、端口范围及目标与 SNI 的关联由 Go 语义校验强制。"
        },
        "server_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"
          }
        },
        "private_key": {
          "$ref": "#/$defs/secretValue128"
        },
        "short_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{2}){0,8}$",
            "minLength": 0,
            "maxLength": 16
          }
        }
      },
      "required": [
        "mode",
        "target",
        "server_names",
        "private_key",
        "short_ids"
      ]
    },
    "outboundDirect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "direct"
        }
      },
      "required": [
        "type"
      ]
    },
    "intentV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "enabled": {
          "type": "boolean"
        },
        "inbound": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9._-]{0,31}$"
            },
            "listen": {
              "$ref": "#/$defs/listenAddr"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "protocol": {
              "const": "vless"
            },
            "transport": {
              "const": "raw"
            },
            "flow": {
              "const": "xtls-rprx-vision"
            },
            "security": {
              "$ref": "#/$defs/realitySecurity"
            },
            "users": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9._-]{0,31}$"
                  },
                  "uuid": {
                    "$ref": "#/$defs/secretValue128"
                  }
                },
                "required": [
                  "id",
                  "uuid"
                ]
              }
            }
          },
          "required": [
            "id",
            "listen",
            "port",
            "protocol",
            "transport",
            "flow",
            "security",
            "users"
          ]
        },
        "outbound": {
          "$ref": "#/$defs/outboundDirect"
        }
      },
      "required": [
        "schema_version",
        "enabled",
        "inbound",
        "outbound"
      ]
    },
    "intentV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "enabled": {
          "type": "boolean"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9._-]{0,31}$"
              },
              "enabled": {
                "type": "boolean"
              },
              "listen": {
                "$ref": "#/$defs/listenAddr"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "vless",
                  "vmess",
                  "trojan",
                  "shadowsocks",
                  "shadowsocks2022",
                  "hysteria2",
                  "anytls",
                  "socks5",
                  "http"
                ]
              },
              "users": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[a-z][a-z0-9._-]{0,31}$"
                    },
                    "username": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "uuid": {
                      "$ref": "#/$defs/secretValue128"
                    },
                    "auth": {
                      "$ref": "#/$defs/secretValue256"
                    },
                    "psk": {
                      "$ref": "#/$defs/secretValue128"
                    },
                    "traffic_mark": {
                      "type": "integer",
                      "minimum": 20736,
                      "maximum": 20991,
                      "description": "可选内核流量整形标记（0x5100..0x51FF，实例内唯一）"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              "vless": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "transport": {
                    "enum": [
                      "raw",
                      "tcp",
                      "grpc",
                      "ws",
                      "xhttp"
                    ]
                  },
                  "flow": {
                    "enum": [
                      "",
                      "xtls-rprx-vision"
                    ]
                  },
                  "security_mode": {
                    "enum": [
                      "",
                      "reality",
                      "tls",
                      "none"
                    ]
                  },
                  "security": {
                    "$ref": "#/$defs/realitySecurity"
                  },
                  "tls": {
                    "$ref": "#/$defs/tlsBinding"
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "host": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "service_name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "xhttp_mode": {
                    "enum": [
                      "",
                      "auto",
                      "packet-up",
                      "stream-up",
                      "stream-one"
                    ]
                  },
                  "decryption": {
                    "$ref": "#/$defs/secretValue256"
                  },
                  "encryption": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "transport"
                ]
              },
              "vmess": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "transport": {
                    "enum": [
                      "raw",
                      "tcp",
                      "ws",
                      "grpc"
                    ]
                  },
                  "security_mode": {
                    "enum": [
                      "none",
                      "tls"
                    ]
                  },
                  "tls": {
                    "$ref": "#/$defs/tlsBinding"
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "host": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "service_name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "transport",
                  "security_mode"
                ]
              },
              "trojan": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "transport": {
                    "enum": [
                      "raw",
                      "tcp",
                      "grpc",
                      "ws"
                    ]
                  },
                  "security_mode": {
                    "enum": [
                      "tls",
                      "reality"
                    ]
                  },
                  "tls": {
                    "$ref": "#/$defs/tlsBinding"
                  },
                  "reality": {
                    "$ref": "#/$defs/realitySecurity"
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "host": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "service_name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "transport",
                  "security_mode"
                ]
              },
              "shadowsocks": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "aes-256-gcm",
                      "aes-128-gcm",
                      "chacha20-ietf-poly1305"
                    ]
                  },
                  "udp": {
                    "type": "boolean"
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "method"
                ]
              },
              "hysteria2": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tls": {
                    "$ref": "#/$defs/tlsBinding"
                  },
                  "obfs_password": {
                    "$ref": "#/$defs/secretValue256"
                  },
                  "port_hopping": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "tls"
                ]
              },
              "anytls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tls": {
                    "$ref": "#/$defs/tlsBinding"
                  },
                  "padding_scheme": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                },
                "required": [
                  "tls"
                ]
              },
              "socks5": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "udp": {
                    "type": "boolean"
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                }
              },
              "http": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sniffing": {
                    "type": "boolean"
                  }
                }
              },
              "shadowsocks2022": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "2022-blake3-aes-128-gcm",
                      "2022-blake3-aes-256-gcm",
                      "2022-blake3-chacha20-poly1305"
                    ]
                  },
                  "server_key": {
                    "$ref": "#/$defs/secretValue128"
                  },
                  "obfs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "enum": [
                          "none",
                          "http",
                          "tls"
                        ]
                      },
                      "host": {
                        "type": "string",
                        "maxLength": 253
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "udp": {
                    "type": "boolean"
                  },
                  "sniffing": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "method",
                  "server_key",
                  "obfs"
                ]
              }
            },
            "required": [
              "id",
              "enabled",
              "listen",
              "port",
              "protocol",
              "users"
            ]
          }
        },
        "outbound": {
          "$ref": "#/$defs/outboundDirect"
        },
        "warp": {
          "$ref": "#/$defs/warpOutbound"
        }
      },
      "required": [
        "schema_version",
        "enabled",
        "profiles",
        "outbound"
      ]
    },
    "warpOutbound": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选 Cloudflare WARP 用户态 WireGuard 出口，支持按绑定端口、解锁域名或全局分流。",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "private_key": {
          "$ref": "#/$defs/secretValue128"
        },
        "peer_public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 44
        },
        "endpoint": {
          "type": "string",
          "minLength": 3,
          "maxLength": 259
        },
        "address_v4": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32
        },
        "address_v6": {
          "type": "string",
          "maxLength": 64
        },
        "reserved": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "mtu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500
        },
        "routing_mode": {
          "enum": [
            "bound_ports",
            "domains",
            "all"
          ]
        },
        "bound_profile_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        }
      },
      "required": [
        "enabled",
        "private_key",
        "peer_public_key",
        "endpoint",
        "address_v4",
        "routing_mode"
      ]
    }
  }
}
