{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qwq:plugin:core.xray:core.capabilities:response:v1",
  "description": "声明目标、锁定版本已验证能力及尚不可用的能力和原因；验证证据不等于实际连接已经验收。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "driver_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "core_version": {
      "type": "string",
      "enum": [
        "",
        "26.11.9"
      ]
    },
    "schema_version": {
      "enum": [
        "1",
        "2"
      ]
    },
    "declared": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "verified": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "unavailable": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "required": [
          "capability",
          "reason"
        ]
      }
    }
  },
  "required": [
    "driver_version",
    "core_version",
    "schema_version",
    "declared",
    "verified",
    "unavailable"
  ]
}
