{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9._-]{0,31}$"
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "inbound",
        "user"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qwq:plugin:core.xray:core.observe:request:v1"
}
