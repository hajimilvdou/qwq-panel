{
  "type": "object",
  "additionalProperties": false,
  "description": "DNS 提供商本地只读摘要响应（兼容首页 stat 微件）",
  "required": [
    "value",
    "unit",
    "percent",
    "sub",
    "level",
    "spark",
    "total",
    "enabled",
    "zones"
  ],
  "properties": {
    "value": {
      "type": "number",
      "minimum": 0,
      "description": "已启用的 DNS 提供商数量"
    },
    "unit": {
      "type": "string",
      "description": "微件数值单位"
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "已启用提供商占比（0-100）"
    },
    "sub": {
      "type": "string",
      "maxLength": 120,
      "description": "微件辅助说明文字"
    },
    "level": {
      "enum": [
        "ok",
        "warn",
        "bad"
      ],
      "description": "健康等级"
    },
    "spark": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "number",
        "minimum": 0
      },
      "description": "历史趋势点"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "已登记的提供商总数"
    },
    "enabled": {
      "type": "integer",
      "minimum": 0,
      "description": "处于启用状态的提供商数量"
    },
    "zones": {
      "type": "integer",
      "minimum": 0,
      "description": "最近同步发现的托管域总数"
    },
    "updated_at": {
      "type": "string",
      "description": "最近一次同步时间（RFC3339）"
    }
  }
}
