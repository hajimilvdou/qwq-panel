{
  "type": "object",
  "additionalProperties": false,
  "description": "应用或对账 DNS 记录变更后的公开收据响应",
  "required": [
    "state",
    "revision"
  ],
  "properties": {
    "state": {
      "type": "string",
      "description": "变更状态（applied、unknown、cleaned、rejected 等）"
    },
    "revision": {
      "type": "string",
      "description": "最新域快照版本"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "description": "变更后的记录公开视图（删除后可能为空）",
      "required": [
        "id",
        "type",
        "name",
        "value",
        "ttl",
        "proxied",
        "revision",
        "managed_challenge"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "记录 ID"
        },
        "type": {
          "type": "string",
          "description": "记录类型"
        },
        "name": {
          "type": "string",
          "description": "完整域名"
        },
        "value": {
          "type": "string",
          "description": "记录值"
        },
        "ttl": {
          "type": "integer",
          "minimum": 0,
          "description": "TTL 秒数"
        },
        "proxied": {
          "type": "boolean",
          "description": "是否启用代理"
        },
        "revision": {
          "type": "string",
          "description": "记录指纹版本"
        },
        "managed_challenge": {
          "type": "boolean",
          "description": "是否由 ACME 挑战托管"
        }
      }
    }
  }
}
