  "dependencies": [],
  "state": {
    "schema_version": "1",
    "minimum_rollback_version": "0.1.0",
    "backup_paths": []
  },
  "config": {
    "schema": "schemas/config.schema.json",
    "hot_apply": true
  },
  "resources": {
    "memory_max_mb": 24,
    "cpu_quota_percent": 5,
    "pids_max": 8,
    "fds_max": 64,
    "disk_max_mb": 16,
    "kv_max_kb": 64
  },
  "ui": {
    "widgets": [
      {
        "id": "cpu",
        "kind": "stat",
        "operation": "monitor.stat.cpu",
        "refresh_seconds": 2,
        "size": "s",
        "title": "CPU"
      },
      {
        "id": "mem",
        "kind": "stat",
        "operation": "monitor.stat.mem",
        "refresh_seconds": 2,
        "size": "s",
        "title": "内存"
      },
      {
        "id": "disk",
        "kind": "stat",
        "operation": "monitor.stat.disk",
        "refresh_seconds": 5,
        "size": "s",
        "title": "根盘"
      },
      {
        "id": "net",
        "kind": "series",
        "operation": "monitor.series.net",
        "refresh_seconds": 2,
        "size": "m",
        "title": "网络吞吐"
      },
      {
        "id": "load",
        "kind": "series",
        "operation": "monitor.series.load",
        "refresh_seconds": 2,
        "size": "m",
        "title": "CPU 与内存"
      }
    ],
    "entry": "ui/index.html",
    "sandbox": true,
    "connect_sources": [],
    "routes": [
      {
        "path": "/monitor",
        "title": "监控",
        "nav": true,
        "permission": "monitor.basic:read"
      }
    ]
  }
}
