      "name": "monitor.stat.cpu",
      "api_version": "v1",
      "permission": "monitor.basic:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "CPU 使用率",
      "capabilities": [
        {
          "name": "metrics.read",
          "scope": "self"
        }
