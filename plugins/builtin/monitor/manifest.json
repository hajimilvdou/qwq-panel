{
  "schema_version": "1.3",
  "id": "monitor.basic",
  "version": "0.1.0",
  "name": "基础监控",
  "summary": "宿主指标与有限内存历史",
  "description": "通过宿主只读 metrics 能力采样，保持默认插件沙箱；历史在内存环中保留，重启后重建。",
