      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/series.response.json"
    },
    {
      "name": "monitor.series.load",
      "api_version": "v1",
      "permission": "monitor.basic:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "CPU 与内存趋势",
      "capabilities": [
        {
          "name": "metrics.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/series.response.json"
    },
    {
      "name": "monitor.snapshot",
      "api_version": "v1",
      "permission": "monitor.basic:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "当前指标与细粒度历史",
      "capabilities": [
        {
          "name": "metrics.read",
          "scope": "self"
        }
