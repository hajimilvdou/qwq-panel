    "schemas/empty.request.json": "sha256:91e1556fb053be7728bab4ce7b2823ca64807c5ffa117a3e8fbba79c683a2344",
    "schemas/notify.ai.digest.response.json": "sha256:0d0eb839ee78e0b2f8d532ce3f174151b2d1420f53f876b26ed52691b434540e",
    "schemas/notify.channel.test.request.json": "sha256:9d745776dde074c0170758ae214e826aeec4136911a629daf4b0e1189fb67ea5",
    "schemas/notify.channel.test.response.json": "sha256:810f42cac2c49901b2ae0bbd4fb506fad8d690b48200002b1f35ed12d2033f18",
    "schemas/notify.channel.upsert.request.json": "sha256:b8f1aca032453f2647dedd753b9c50bb4c769c3f875c7fe57c5eb4030249e5ea",
    "schemas/notify.channel.upsert.response.json": "sha256:cf744bd5010e66229e03fbc68f9cf9419f834af29ac8caddc3314be28c5aa997",
    "schemas/notify.delete.response.json": "sha256:d6b9084de92a9a5640506e09e8395dbfafcee62232d781e1856b112b65f17d75",
    "schemas/notify.dispatch.request.json": "sha256:c809094ff2be4eb7cdb1a52eb88245c7d13b1c92a24c6aac0c807a7d3b7629ce",
    "schemas/notify.dispatch.response.json": "sha256:ac6905902e0eddcc0cb141fdbb6b34bc67bed0f4c399b580efedbf2d58f16650",
    "schemas/notify.id.request.json": "sha256:94b6382be7e0bb471952ea5e274d039c44640acecec4fcfd8dd7c05421e476f8",
    "schemas/notify.overview.response.json": "sha256:d7d22b5477387f165b7baeed7694a988337bed0a8374fa43f37dccc2f614b076",
    "schemas/notify.rule.upsert.request.json": "sha256:677383e5088e5c675612671a0599ebdbab66b348047de5538cab096e1974442a",
    "schemas/notify.rule.upsert.response.json": "sha256:81b9b6d31807b67ad8f4c2584b5b71b53668431bd73b0ed3cf7e98771775775f",
    "schemas/stat.response.json": "sha256:3c1827800ca69d083441719bb82ef1e2914249c315d342ef8e4d1d7098119985",
    "ui/index.html": "sha256:8ab34bdccce7ba49d6779855ea3ed5f7345bb451f9702d0c92dee10fd6bba64c",
    "ui/plugin.css": "sha256:f47e3a3cff4f7a1f0f47ec7155b8f9e8321a41c48b9fdb201341c81dd60022f1",
    "ui/plugin.js": "sha256:c565ed34e65965083cf4aaeed51f5e92ab36dcdb246650b84a3e96a0259d276c"
  },
  "provenance": {
    "sbom": "attestations/sbom.spdx.json"
  },
  "placement": "node",
  "lifecycle": {
    "startup": "on_demand",
    "background": false,
    "update_strategy": "restart",
    "overlap_safe": false
  },
  "operations": [
    {
      "name": "notify.stat.summary",
      "api_version": "v1",
      "permission": "notify.hub:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "通知渠道数量与 24 小时投递概况",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/stat.response.json"
    },
    {
      "name": "notify.checks.channels",
      "api_version": "v1",
      "permission": "notify.hub:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "各通知通道最近投递健康状态",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/checks.response.json"
    },
    {
      "name": "notify.overview",
      "api_version": "v1",
      "permission": "notify.hub:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "ui_route": "/notify",
      "summary": "查看全部脱敏通知渠道、路由规则与近期投递记录",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/notify.overview.response.json"
    },
    {
      "name": "notify.ai.digest",
      "api_version": "v1",
      "permission": "notify.hub:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "输出低于 2KiB 的通知健康与失败摘要供原生 AI 诊断",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/notify.ai.digest.response.json"
    },
    {
      "name": "notify.channel.upsert",
      "api_version": "v1",
      "permission": "notify.hub:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 5000,
      "approval": "ai_confirm",
      "approval_summary": "新增或修改告警通知渠道",
      "approval_description": "加密保存通知通道的 Webhook / Bot Token / SMTP 凭据并更新启用状态。",
      "summary": "新增或更新通知渠道配置",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.channel.upsert.request.json",
      "response_schema": "schemas/notify.channel.upsert.response.json"
    },
    {
      "name": "notify.channel.delete",
      "api_version": "v1",
      "permission": "notify.hub:delete",
      "mode": "invoke",
      "effect": "destructive",
      "risk": "high",
      "idempotent": true,
      "timeout_ms": 5000,
      "approval": "confirm",
      "approval_summary": "删除告警通知渠道",
      "approval_description": "永久删除指定通知渠道及其加密凭据，引用该渠道的路由将不再向其推送。",
      "summary": "删除指定通知渠道",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.id.request.json",
      "response_schema": "schemas/notify.delete.response.json"
    },
    {
      "name": "notify.channel.test",
      "api_version": "v1",
      "permission": "notify.hub:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "low",
      "idempotent": false,
      "timeout_ms": 15000,
      "approval": "auto",
      "summary": "向指定通知渠道发送一条连通性测试消息",
      "capabilities": [
        {
          "name": "network.egress",
          "scope": "notify"
        },
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.channel.test.request.json",
      "response_schema": "schemas/notify.channel.test.response.json"
    },
    {
      "name": "notify.rule.upsert",
      "api_version": "v1",
      "permission": "notify.hub:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 5000,
      "approval": "ai_confirm",
      "approval_summary": "新增或修改告警路由与静默规则",
      "approval_description": "配置告警来源通配、最低级别、冷却去重秒数与静默时段窗口。",
      "summary": "新增或更新告警路由与静默降噪规则",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.rule.upsert.request.json",
      "response_schema": "schemas/notify.rule.upsert.response.json"
    },
    {
      "name": "notify.rule.delete",
      "api_version": "v1",
      "permission": "notify.hub:delete",
      "mode": "invoke",
      "effect": "destructive",
      "risk": "high",
      "idempotent": true,
      "timeout_ms": 5000,
      "approval": "confirm",
      "approval_summary": "删除告警路由规则",
      "approval_description": "删除后匹配该规则的告警将不再自动转发至原定通知渠道。",
      "summary": "删除指定告警路由规则",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.id.request.json",
      "response_schema": "schemas/notify.delete.response.json"
    },
    {
      "name": "notify.dispatch",
      "api_version": "v1",
      "permission": "notify.hub:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "low",
      "idempotent": false,
      "timeout_ms": 30000,
      "approval": "auto",
      "approval_summary": "触发告警通知分发",
      "approval_description": "按既有路由规则、冷却去重和静默时段向匹配的外部通知通道推送结构化事件。",
      "summary": "按路由规则与降噪策略分发一条结构化告警事件",
      "capabilities": [
        {
          "name": "network.egress",
          "scope": "notify"
        },
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/notify.dispatch.request.json",
      "response_schema": "schemas/notify.dispatch.response.json"
    }
  ],
  "capabilities": [
    {
      "name": "network.egress",
      "scope": "notify",
      "reason": "通过默认防 SSRF 校验的出站连接向 Telegram/飞书/钉钉/企微/Discord/SMTP/Webhook 推送告警"
    },
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取通知渠道脱敏视图、路由规则与投递审计"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "加密保存通知凭据、更新路由规则与记录投递历史"
    }
  ],
  "dependencies": [],
  "state": {
    "schema_version": "1",
    "minimum_rollback_version": "0.1.0",
    "backup_paths": [
      "notify.db",
      "notify.key"
    ]
  },
  "config": {
    "schema": "schemas/config.schema.json",
    "hot_apply": true
  },
  "resources": {
    "memory_max_mb": 24,
    "cpu_quota_percent": 10,
    "pids_max": 16,
    "fds_max": 128,
    "disk_max_mb": 64,
    "kv_max_kb": 128
  },
  "ui": {
    "widgets": [
      {
        "id": "summary",
        "title": "告警通知中枢",
        "kind": "stat",
        "operation": "notify.stat.summary",
        "refresh_seconds": 10,
        "size": "s",
        "color": "amber"
      },
      {
        "id": "channels",
        "title": "通知通道健康",
        "kind": "checks",
        "operation": "notify.checks.channels",
        "refresh_seconds": 15,
        "size": "m",
        "color": "teal"
      }
    ],
    "entry": "ui/index.html",
    "sandbox": true,
    "connect_sources": [],
    "routes": [
      {
        "path": "/notify",
        "title": "通知中枢",
        "nav": true,
        "permission": "notify.hub:read"
      }
    ]
  }
}
