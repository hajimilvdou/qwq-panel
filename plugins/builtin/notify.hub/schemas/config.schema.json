{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notify.hub plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_private_endpoints": {
      "type": "boolean",
      "default": false
    },
    "http_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 10
    }
  }
}
