{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "title"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "critical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    },
    "dedup_key": {
      "type": "string",
      "maxLength": 128
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    }
  }
}
