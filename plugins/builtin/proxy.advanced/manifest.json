  "capabilities": [
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取代理与订阅插件本地轻量状态缓存"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "持久化代理与订阅插件本地轻量状态缓存"
    },
    {
      "name": "network.proxy",
      "scope": "direct",
      "reason": "运行深度内置的 Xray v26.11.9 与 AnyTLS 代理数据面"
    },
    {
      "name": "system.traffic.shape",
      "scope": "self",
      "reason": "查询内核 HTB 整形能力并下发 0x5100..0x51FF 逐用户限速类"
    },
    {
      "name": "public.route",
      "scope": "sub",
      "reason": "通过高熵令牌对外提供 Clash/sing-box/v2ray 多协议订阅拉取接口"
    },
    {
      "name": "network.listen",
      "scope": "brutal",
      "reason": "为选定 TCP 订阅入站启动 TCP Brutal 端口透明接管监听"
    },
    {
      "name": "network.egress",
      "scope": "chain",
      "reason": "对链式代理落地节点发起 TCP 延迟探测与转发校验"
    },
    {
      "name": "system.sysctl.tune",
      "scope": "self",
      "reason": "读取宿主机网络栈参数并执行带快照回滚的 tcpfit 动态调优"
    },
    {
      "name": "secret.reveal",
      "scope": "operation",
      "reason": "读取一次性提交的许可证与节点密钥"
    },
    {
      "name": "plugin.invoke",
      "scope": "tls.certificates/certificates.list",
      "reason": "读取面板已签发的 TLS 证书清单，支持建节点时下拉直选绑定"
    }
  ],
