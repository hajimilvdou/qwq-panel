  "capabilities": [
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取高级代理插件本地轻量状态缓存"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "持久化高级代理插件本地轻量状态缓存"
    },
    {
      "name": "plugin.config.read",
      "scope": "core.xray",
      "reason": "读取 core.xray 脱敏配置快照以便保留既有密钥槽位合并多用户列表"
    },
    {
      "name": "plugin.config.write",
      "scope": "core.xray",
      "reason": "同步活跃多用户列表与 traffic_mark 到 core.xray 并触发受控生效"
    },
    {
      "name": "plugin.invoke",
      "scope": "core.xray/core.observe",
      "reason": "按需查询 core.xray 运行流量计数器"
    },
    {
      "name": "plugin.invoke",
      "scope": "core.xray/core.status",
      "reason": "查询 core.xray 当前运行状态"
    },
    {
      "name": "plugin.invoke",
      "scope": "core.xray/core.apply",
      "reason": "触发 core.xray 应用最新多用户代理配置"
    },
    {
      "name": "plugin.invoke.background",
      "scope": "core.xray/core.observe",
      "reason": "后台 30 秒周期采样 core.xray 逐用户流量以执行配额与到期巡检"
    },
    {
      "name": "plugin.invoke.background",
      "scope": "core.xray/core.status",
      "reason": "后台巡检核对 core.xray 运行状态"
    },
    {
      "name": "system.traffic.shape",
      "scope": "self",
      "reason": "查询内核 HTB 整形能力并下发 0x5100..0x51FF 逐用户限速类"
    },
    {
      "name": "public.route",
      "scope": "sub",
      "reason": "通过高熵令牌对外提供 Clash/sing-box/v2ray 多协议订阅拉取接口"
    },
    {
      "name": "network.listen",
      "scope": "brutal",
      "reason": "为选定 TCP 订阅入站启动 TCP Brutal 端口透明接管监听"
    },
    {
      "name": "network.egress",
      "scope": "chain",
      "reason": "对链式代理落地节点发起 TCP 延迟探测与转发校验"
    },
    {
      "name": "system.sysctl.tune",
      "scope": "self",
      "reason": "读取宿主机网络栈参数并执行带快照回滚的 tcpfit 动态调优"
    }
  ],
