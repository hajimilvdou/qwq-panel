{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "查询 TCP Brutal 状态响应",
  "description": "返回 Brutal 内核环境、可选 TCP 入站、绑定列表与运行指标。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "env",
    "tcp_inbounds",
    "bindings",
    "live_listeners",
    "default_oversend",
    "default_cwnd_gain"
  ],
  "properties": {
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_version",
        "current_cc",
        "brutal_available",
        "ebpf_pinned",
        "install_hint"
      ],
      "properties": {
        "kernel_version": {
          "type": "string"
        },
        "available_cc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_cc": {
          "type": "string"
        },
        "brutal_available": {
          "type": "boolean"
        },
        "ebpf_pinned": {
          "type": "boolean"
        },
        "brutalctl_path": {
          "type": "string"
        },
        "install_hint": {
          "type": "string"
        },
        "degraded_guidance": {
          "type": "string"
        }
      }
    },
    "tcp_inbounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inbound_tag",
          "protocol",
          "target_port",
          "label"
        ],
        "properties": {
          "inbound_tag": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "target_port": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inbound_tag",
          "protocol",
          "enabled",
          "listen_port",
          "target_port",
          "bandwidth_mbps",
          "oversend_pct",
          "cwnd_gain",
          "effective_mbps",
          "enable_in_sub",
          "revision",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "inbound_tag": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "vless",
              "shadowsocks",
              "trojan",
              "tcp"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "listen_port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "target_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "bandwidth_mbps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "oversend_pct": {
            "type": "integer",
            "minimum": 100,
            "maximum": 250
          },
          "cwnd_gain": {
            "type": "integer",
            "minimum": 10,
            "maximum": 50
          },
          "effective_mbps": {
            "type": "number",
            "minimum": 1
          },
          "enable_in_sub": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "live_listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "inbound_tag",
          "running",
          "active_conns",
          "total_conns",
          "brutal_applied_conns",
          "fallback_conns",
          "bytes_tx",
          "bytes_rx"
        ],
        "properties": {
          "binding_id": {
            "type": "string"
          },
          "inbound_tag": {
            "type": "string"
          },
          "bound_addr": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          },
          "active_conns": {
            "type": "integer",
            "minimum": 0
          },
          "total_conns": {
            "type": "integer",
            "minimum": 0
          },
          "brutal_applied_conns": {
            "type": "integer",
            "minimum": 0
          },
          "fallback_conns": {
            "type": "integer",
            "minimum": 0
          },
          "bytes_tx": {
            "type": "integer",
            "minimum": 0
          },
          "bytes_rx": {
            "type": "integer",
            "minimum": 0
          },
          "last_sockopt_error": {
            "type": "string"
          }
        }
      }
    },
    "default_oversend": {
      "type": "integer"
    },
    "default_cwnd_gain": {
      "type": "integer"
    }
  }
}
