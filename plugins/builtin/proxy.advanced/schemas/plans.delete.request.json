{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "删除代理套餐请求",
  "description": "删除未被任何用户绑定的代理套餐模板。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "description": "要删除的套餐唯一 ID。"
    }
  }
}
