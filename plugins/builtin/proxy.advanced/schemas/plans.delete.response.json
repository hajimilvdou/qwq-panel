{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "删除代理套餐响应",
  "description": "返回套餐删除结果。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deleted",
    "id"
  ],
  "properties": {
    "deleted": {
      "type": "boolean",
      "description": "是否成功删除了目标套餐。"
    },
    "id": {
      "type": "string",
      "description": "目标套餐 ID。"
    }
  }
}
