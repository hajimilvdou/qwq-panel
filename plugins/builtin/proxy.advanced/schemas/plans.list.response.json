{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "代理套餐列表响应",
  "description": "返回已定义的流量配额与限速套餐列表。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plans"
  ],
  "properties": {
    "plans": {
      "type": "array",
      "description": "套餐详情列表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "quota_bytes",
          "down_limit_kbps",
          "up_limit_kbps",
          "billing_reset_day",
          "validity_days",
          "created_at",
          "updated_at",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "套餐唯一 ID。"
          },
          "name": {
            "type": "string",
            "description": "套餐显示名称。"
          },
          "description": {
            "type": "string",
            "description": "套餐说明简介。"
          },
          "traffic_mode": {
            "type": "string",
            "enum": ["both", "both_2x", "down_only"],
            "description": "流量计费方式。"
          },
          "node_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关联节点 ID 白名单（空数组表示不限节点）。"
          },
          "rule_preset": {
            "type": "string",
            "description": "套餐级分流预设覆盖。"
          },
          "quota_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "每周期总流量配额（字节，0 表示不限）。"
          },
          "down_limit_kbps": {
            "type": "integer",
            "minimum": 0,
            "description": "下行带宽限速（kbps，0 表示不限）。"
          },
          "up_limit_kbps": {
            "type": "integer",
            "minimum": 0,
            "description": "上行带宽限速（kbps，0 表示不限）。"
          },
          "max_connections": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "套餐默认最大并发 TCP 连接数（0 表示不限）。"
          },
          "max_ips": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024,
            "description": "套餐默认最大同时在线 IP 数（0 表示不限）。"
          },
          "billing_reset_day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 28,
            "description": "每月计费重置日（1-28，0 表示不自动重置）。"
          },
          "validity_days": {
            "type": "integer",
            "minimum": 0,
            "description": "新建用户的默认有效天数（0 表示长期有效）。"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0,
            "description": "创建时间戳（Unix 毫秒）。"
          },
          "updated_at": {
            "type": "integer",
            "minimum": 0,
            "description": "更新时间戳（Unix 毫秒）。"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "description": "套餐修订号。"
          }
        }
      }
    }
  }
}
