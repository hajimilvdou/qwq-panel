{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "高级代理概览响应",
  "description": "首页 stat 微件兼容的多用户、配额与限速概览数据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "unit",
    "percent",
    "sub",
    "level",
    "spark",
    "total_plans",
    "total_users",
    "active_users",
    "suspended_quota_users",
    "expired_users",
    "disabled_users",
    "period_up_bytes",
    "period_down_bytes",
    "used_traffic_marks",
    "shaping_supported",
    "shaping_degraded_reason"
  ],
  "properties": {
    "value": { "type": "number", "description": "主数值：当前活跃代理用户数。" },
    "unit": { "type": "string", "description": "数值单位。" },
    "percent": { "type": "number", "minimum": 0, "maximum": 100, "description": "已占 traffic_mark 槽位占比（上限 256）。" },
    "sub": { "type": "string", "description": "副标题摘要说明。" },
    "level": { "type": "string", "enum": ["ok", "warn", "crit", "muted"], "description": "状态告警级别。" },
    "spark": { "type": "array", "description": "近期活跃用户趋势序列。", "items": { "type": "number" } },
    "total_plans": { "type": "integer", "minimum": 0, "description": "已配置套餐总数。" },
    "total_users": { "type": "integer", "minimum": 0, "description": "代理用户总数。" },
    "active_users": { "type": "integer", "minimum": 0, "description": "当前活跃用户数。" },
    "suspended_quota_users": { "type": "integer", "minimum": 0, "description": "因超流量配额暂停的用户数。" },
    "expired_users": { "type": "integer", "minimum": 0, "description": "已到期停用的用户数。" },
    "disabled_users": { "type": "integer", "minimum": 0, "description": "管理员手动停用的用户数。" },
    "period_up_bytes": { "type": "integer", "minimum": 0, "description": "当前计费周期所有用户累计上行字节数。" },
    "period_down_bytes": { "type": "integer", "minimum": 0, "description": "当前计费周期所有用户累计下行字节数。" },
    "used_traffic_marks": { "type": "integer", "minimum": 0, "maximum": 256, "description": "已分配的 HTB traffic_mark 槽位数。" },
    "shaping_supported": { "type": "boolean", "description": "内核 HTB 带宽限速是否可用。" },
    "shaping_degraded_reason": { "type": "string", "description": "内核限速不可用或降级时的原因说明。" },
    "detected_public_host": { "type": "string", "description": "已配置或自动探测到的本机公网连接地址（IP 或域名）。" },
    "core_obfs_available": { "type": "boolean", "description": "内置 Xray 引擎是否具备可用的 simple-obfs (obfs-server) 二进制。" },
    "xray_engine": {
      "type": "object",
      "description": "内置 Xray / AnyTLS 引擎运行状态摘要。",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string" },
        "core_version": { "type": "string" },
        "binary_trusted": { "type": "boolean" },
        "process_state": { "type": "string" },
        "api_state": { "type": "string" },
        "proxy_available": { "type": "boolean" },
        "active_profiles": { "type": "integer", "minimum": 0 },
        "obfs_available": { "type": "boolean" },
        "anytls_active": { "type": "boolean" },
        "reset_epoch": { "type": "string" },
        "revision": { "type": "string" },
        "last_error": { "type": "string" }
      }
    }
  }
}
