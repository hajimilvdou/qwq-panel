{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "应用 tcpfit 内核调优请求",
  "description": "先保存当前宿主机基线快照，再写入 /etc/sysctl.d/99-qwq-tcpfit.conf 并可选执行 sysctl -p。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "proxy",
        "relay",
        "web"
      ],
      "default": "proxy"
    },
    "bandwidth_mbps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 200
    },
    "rtt_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 150
    },
    "mem_budget_pct": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30,
      "default": 12
    },
    "prefer_cc": {
      "type": "string",
      "enum": [
        "auto",
        "bbr",
        "brutal",
        "cubic"
      ],
      "default": "auto"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "演练模式：仅保存基线快照并返回配置，不改动宿主机内核。"
    }
  }
}
