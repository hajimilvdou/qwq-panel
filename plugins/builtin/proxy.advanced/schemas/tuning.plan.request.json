{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "推导 tcpfit 动态调优方案请求",
  "description": "依据节点角色、带宽、RTT 与内存预算动态推导 1C1G 安全防 OOM 的 sysctl 调优参数。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "proxy",
        "relay",
        "web"
      ],
      "default": "proxy"
    },
    "bandwidth_mbps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 200
    },
    "rtt_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 150
    },
    "mem_budget_pct": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30,
      "default": 12
    },
    "prefer_cc": {
      "type": "string",
      "enum": [
        "auto",
        "bbr",
        "brutal",
        "cubic"
      ],
      "default": "auto"
    }
  }
}
