{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "运行 iperf3 限速器拐点探测请求",
  "description": "调用宿主机 iperf3 检测线路吞吐与重传拐点（若未安装则诚实返回不可用与指引命令）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "peer_host"
  ],
  "properties": {
    "peer_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "peer_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 5201
    },
    "duration_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "default": 5
    }
  }
}
