{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "轮换用户订阅令牌请求",
  "description": "作废旧订阅令牌并签发新的高熵令牌（数据库仅存储 SHA-256 哈希）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id"],
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "description": "目标代理用户 ID。"
    },
    "expected_revision": {
      "type": "string",
      "maxLength": 64,
      "description": "可选乐观并发修订号。"
    }
  }
}
