  "capabilities": [
    {
      "name": "system.firewall.manage",
      "scope": "self",
      "reason": "读取、应用与重置 inet qwq 防火墙规则集并探测共存防火墙管理器"
    },
    {
      "name": "system.sshd.configure",
      "scope": "self",
      "reason": "读取 sshd 生效配置、执行双端口零断连改端口事务与设置 SSH 登录策略"
    },
    {
      "name": "system.account.keys",
      "scope": "all",
      "reason": "列举、导入、回退生成与移除系统用户 authorized_keys 公钥"
    },
    {
      "name": "system.account.password",
      "scope": "all",
      "reason": "通过宿主密文引用修改系统用户口令（插件全程不接触明文）"
    },
    {
      "name": "system.ban.manage",
      "scope": "self",
      "reason": "增量扫描 SSH 认证失败日志并维护 inet qwq 封禁集合"
    },
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取防爆破扫描游标、安全概览缓存与 SSH 端口切换事务状态"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "持久化防爆破扫描游标、安全概览缓存与 SSH 端口切换事务状态"
    }
  ],
