{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "修改系统用户口令请求",
  "description": "通过宿主密文引用修改系统用户口令；密码字段由宿主提取为密文引用，插件全程不接触明文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["user"],
  "properties": {
    "user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_.-]{0,31}$",
      "description": "目标系统用户名。"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-secret": true,
      "writeOnly": true,
      "description": "新口令密文字段（由宿主边界自动转换为密文引用传入，插件不读取明文）。"
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-secret": true,
      "writeOnly": true,
      "description": "已由宿主签发的口令密文引用；与 password 二选一提供。"
    },
    "expected_revision": {
      "type": "string",
      "maxLength": 128,
      "description": "可选 account/<user>/password 期望修订号。"
    }
  }
}
