{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "手动添加封禁 IP 请求",
  "description": "将单个或多个来源 IP 加入 inet qwq 封禁集合；宿主强制拒绝封禁当前管理会话 IP 及白名单。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ip": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "单个待封禁 IP 地址（与 entries 二选一）。"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 604800,
      "description": "单个 IP 的封禁超时秒数；留空时采用插件配置 ban_ttl_seconds（默认 3600 秒）。"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "description": "批量封禁条目列表（与 ip 二选一）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip"],
        "properties": {
          "ip": { "type": "string", "minLength": 2, "maxLength": 64, "description": "待封禁 IPv4/IPv6 地址。" },
          "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 604800, "description": "封禁超时秒数。" }
        }
      }
    },
    "expected_revision": {
      "type": "string",
      "maxLength": 128,
      "description": "可选 ban/set 期望修订号。"
    }
  }
}
