  "capabilities": [
    {
      "name": "metrics.read",
      "scope": "self",
      "reason": "免安装外部 Agent 直接采集本机 CPU、内存、磁盘、网卡吞吐与系统负载"
    },
    {
      "name": "public.route",
      "scope": "portal",
      "reason": "暴露无面板会话污染的对外服务器探针状态页与独立探针前后台切换入口"
    },
    {
      "name": "public.route",
      "scope": "agent",
      "reason": "接收外部多台服务器小鸡的单向零指令 HTTPS 遥测上报"
    },
    {
      "name": "network.egress",
      "scope": "probe",
      "reason": "执行防 SSRF 校验的公网 HTTP/TCP 延迟拨测并发送离线与流量告警通知"
    },
    {
      "name": "network.listen",
      "scope": "custom-domain",
      "reason": "在未安装面板域名/证书插件或只装探针时，支持探针自身独立绑定域名与内置 ACME/PEM 证书监听"
    },
    {
      "name": "secret.reveal",
      "scope": "self",
      "reason": "安全读取导入的探针自定义证书私钥、告警 Webhook 凭据与独立管理口令密文"
    },
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取微件摘要与域名绑定快照"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "保存脱敏微件摘要与独立域名路由元数据"
    }
  ],
