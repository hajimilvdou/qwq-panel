{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "state"],
        "properties": {
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "state": { "type": "string", "enum": ["ok", "warn", "crit", "muted"] }
        }
      }
    }
  }
}
