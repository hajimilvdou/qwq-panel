{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "none",
        "local",
        "url"
      ]
    },
    "image_base64": {
      "type": "string"
    },
    "mime_type": {
      "type": "string",
      "maxLength": 64
    },
    "lqip_data_url": {
      "type": "string",
      "maxLength": 16384
    },
    "focal_x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "focal_y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "luminance": {
      "type": "integer",
      "minimum": -1,
      "maximum": 255
    },
    "dominant_rgb": {
      "type": "string",
      "maxLength": 20
    },
    "external_url": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
