{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "target_addr"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "enum": [
        "tcp",
        "http",
        "https"
      ]
    },
    "carrier_tag": {
      "type": "string",
      "enum": [
        "ct",
        "cu",
        "cm",
        "global",
        "custom"
      ]
    },
    "target_addr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "interval_sec": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    },
    "expected_status_min": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "expected_status_max": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "public_visible": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
