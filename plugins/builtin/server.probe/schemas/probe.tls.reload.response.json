{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_ref",
    "running",
    "generation"
  ],
  "properties": {
    "binding_ref": {
      "type": "string"
    },
    "running": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "string"
    },
    "leaf_fingerprint": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "sni": {
      "type": "string"
    }
  }
}
