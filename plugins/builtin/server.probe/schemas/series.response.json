{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit", "series"],
  "properties": {
    "unit": { "type": "string" },
    "max": { "type": ["number", "null"] },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "points"],
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "string" },
          "points": {
            "type": "array",
            "items": { "type": "array" }
          }
        }
      }
    }
  }
}
