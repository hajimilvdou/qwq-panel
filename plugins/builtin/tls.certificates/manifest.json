    "schemas/certificates.test.request.json": "sha256:37e7d36ca0783e32838c3165fcdb3c22b92dded856a746256ddfc90767eac1c4",
    "schemas/certificates.view.response.json": "sha256:03c130d6c34620e32bcf9881cafc3a83417c6f2d1f893f5d511c8eb8a920b007",
    "schemas/config.schema.json": "sha256:374dfa3da07c0a68188b20d2dbc9449e0df80c0b76f736a3de6e6e3a330bfe7a",
    "schemas/empty.request.json": "sha256:51bace26fd009dfac9ff182f3bd8ef61235951f3e91ccb7c3e40d91c2488a648",
    "schemas/generations.remove.request.json": "sha256:6f5abad584f956241f96b3293e5936abb8cf4ca42e7f797f792fbf69d2991d1a",
    "schemas/renew_existing.request.json": "sha256:382b407c16cf65b1bcf50412afa3af1c73678b1ae874fa4e1f95114c61a0416d",
    "schemas/renewal.configure.request.json": "sha256:4816c9d35f55f24bb8d01b53bf100debe82b919b63790f3838fee35392a15db9",
    "schemas/renewal.target.request.json": "sha256:98617422a6140266126f3172aac462a55f35c00fb4228f04f4fc82ee9101fc3d",
    "schemas/renewal.view.response.json": "sha256:b7a5e6a68129bdfc3fd5013576682fa27140cbb274a7a6045af017ad4444d0e7",
    "ui/certs.js": "sha256:6055418f31af3dc1a1034906aea08d3892ccaba93d8b67a54a96a2d15ab65882",
