    "schemas/certificates.list.response.json": "sha256:f09f21142105021376d1de042b25bbd79a347ba469a428f498b4eadb6a5877ca",
    "schemas/certificates.remove.request.json": "sha256:2b5e78b5db5bf04f76822afd4afcb83e9b5a77d83568076946dcbc17db1796b9",
