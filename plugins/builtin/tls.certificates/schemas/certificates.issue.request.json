{
  "type": "object",
  "additionalProperties": false,
  "description": "通过受控 ACME DNS-01 或 HTTP-01 签发证书请求（严格对齐 hostauth.IssueCertificateArgs）",
  "required": [
    "certificate_id",
    "attempt_id",
    "spec",
    "ca",
    "accept_terms"
  ],
  "properties": {
    "certificate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "证书资源唯一 ID"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "本次签发幂等尝试 ID"
    },
    "challenge_type": {
      "type": "string",
      "enum": [
        "dns-01",
        "http-01"
      ],
      "default": "dns-01",
      "description": "ACME 验证方式：dns-01（支持泛域名，需联动 domain.dns）或 http-01（免 DNS Token，经内置 web.ingress 80 端口验证）"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "证书精确域名集合与用途规格",
      "required": [
        "sans",
        "purpose"
      ],
      "properties": {
        "sans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": "精确 SAN 域名列表（续期时保持不变）"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "tls_server",
            "tls_server_test"
          ],
          "description": "证书材料用途"
        }
      }
    },
    "provider_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]*$",
      "description": "已授权的 DNS 提供商 ID（DNS-01 模式必填，HTTP-01 模式留空）"
    },
    "zone_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]*$",
      "description": "已授权的 DNS 托管域 ID（DNS-01 模式必填，HTTP-01 模式留空）"
    },
    "ca": {
      "type": "string",
      "enum": [
        "letsencrypt",
        "letsencrypt_staging"
      ],
      "description": "受控 ACME CA 标识（不接受自定义 CA URL）"
    },
    "accept_terms": {
      "type": "boolean",
      "description": "是否明确接受所选受控 CA 的服务条款"
    }
  }
}
