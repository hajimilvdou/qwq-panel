{
  "type": "object",
  "additionalProperties": false,
  "description": "签发受限自签名测试证书请求（严格对齐 hostauth.TestCertificateArgs）",
  "required": [
    "certificate_id",
    "attempt_id",
    "spec"
  ],
  "properties": {
    "certificate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "测试证书资源 ID"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "本次测试签发幂等尝试 ID"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "测试证书精确 SAN 与用途规格",
      "required": [
        "sans",
        "purpose"
      ],
      "properties": {
        "sans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": "测试证书 SAN 域名列表"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "tls_server",
            "tls_server_test"
          ],
          "description": "证书用途（仅限受限测试消费者）"
        }
      }
    }
  }
}
