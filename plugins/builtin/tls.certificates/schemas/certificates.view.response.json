{
  "type": "object",
  "additionalProperties": false,
  "description": "单份证书公开视图响应",
  "required": [
    "certificate"
  ],
  "properties": {
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sans",
        "purpose",
        "status",
        "latest_generation",
        "generations",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "证书资源 ID"
        },
        "revision": {
          "type": "string",
          "description": "最新乐观锁版本"
        },
        "sans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "精确域名（SAN）列表"
        },
        "purpose": {
          "type": "string",
          "description": "证书用途"
        },
        "status": {
          "type": "string",
          "description": "证书与消费者综合状态"
        },
        "latest_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "最新证书代"
        },
        "generations": {
          "type": "array",
          "description": "历史证书代列表",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "fingerprint",
              "issuer",
              "not_before",
              "not_after",
              "trust"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "description": "代号"
              },
              "fingerprint": {
                "type": "string",
                "description": "叶证书指纹"
              },
              "issuer": {
                "type": "string",
                "description": "签发机构"
              },
              "not_before": {
                "type": "string",
                "description": "生效时间"
              },
              "not_after": {
                "type": "string",
                "description": "过期时间"
              },
              "trust": {
                "type": "string",
                "description": "信任级别"
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "description": "消费者绑定状态列表",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding_ref",
              "plugin_id",
              "profile_id",
              "node_id",
              "server_name",
              "purpose",
              "generation",
              "running_generation",
              "policy_revision",
              "status"
            ],
            "properties": {
              "binding_ref": {
                "type": "string",
                "description": "绑定引用 ID"
              },
              "plugin_id": {
                "type": "string",
                "description": "消费者插件 ID"
              },
              "profile_id": {
                "type": "string",
                "description": "逻辑配置 ID"
              },
              "node_id": {
                "type": "string",
                "description": "节点 ID"
              },
              "server_name": {
                "type": "string",
                "description": "SNI 域名"
              },
              "purpose": {
                "type": "string",
                "description": "消费用途"
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "description": "目标证书代"
              },
              "running_generation": {
                "type": "integer",
                "minimum": 0,
                "description": "运行中证书代"
              },
              "policy_revision": {
                "type": "string",
                "description": "许可版本"
              },
              "status": {
                "type": "string",
                "description": "验证状态"
              },
              "previous_generation": {
                "type": "integer",
                "minimum": 0,
                "description": "前代编号"
              }
            }
          }
        }
      }
    }
  }
}
