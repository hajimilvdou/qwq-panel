{
  "type": "object",
  "additionalProperties": false,
  "description": "宿主受控自动续期调度器专用的既有证书续期参数（严格对齐 hostauth.RenewExistingArgs）",
  "required": [
    "policy_id",
    "policy_revision",
    "certificate_id",
    "run_attempt_id",
    "attempt_id"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "已激活的自动续期策略 ID"
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "当前生效的续期策略版本"
    },
    "certificate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "目标证书资源 ID"
    },
    "run_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "本次续期运行租约 attempt ID"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "本次证书签发子尝试 attempt ID"
    }
  }
}
