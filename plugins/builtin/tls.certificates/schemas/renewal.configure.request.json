{
  "type": "object",
  "additionalProperties": false,
  "description": "登记或更新证书自动续期策略范围请求（严格对齐 hostauth.RenewalPolicyArgs）",
  "required": [
    "policy_id",
    "certificate_id",
    "provider_id",
    "zone_id",
    "ca",
    "binding_refs",
    "expires_at"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "自动续期策略唯一 ID"
    },
    "certificate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "关联的证书资源 ID"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "已授权的 DNS 提供商 ID"
    },
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "已授权的 DNS 托管域 ID"
    },
    "ca": {
      "type": "string",
      "enum": [
        "letsencrypt",
        "letsencrypt_staging"
      ],
      "description": "受控 ACME CA 标识"
    },
    "binding_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "description": "续期后需要同步部署的已确认绑定引用 ID 列表"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "续期授权截止时间（RFC3339 格式）"
    }
  }
}
