      "risk": "high",
      "idempotent": true,
      "timeout_ms": 5000,
      "approval": "confirm",
      "approval_summary": "删除反向代理站点",
      "approval_description": "删除该域名反代规则（变更前自动保留历史快照，支持一键回滚）。",
      "summary": "删除指定反向代理站点",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
