      "permission": "web.ingress:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 10000,
      "approval": "confirm",
      "approval_summary": "热重载反向代理路由并同步渲染配置",
      "approval_description": "原子切换内置反代路由表并同步写入 Caddyfile / Nginx 渲染配置，不中断在途连接。",
      "summary": "热重载反代路由表并原子落盘渲染配置",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        },
        {
          "name": "network.listen",
          "scope": "ingress"
        }
      ],
      "request_schema": "schemas/empty.request.json",
      "response_schema": "schemas/ingress.apply.response.json"
    },
