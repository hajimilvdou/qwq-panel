      "name": "ingress.rollback",
      "api_version": "v1",
      "permission": "web.ingress:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 10000,
      "approval": "confirm",
      "approval_summary": "回滚反向代理站点至历史快照",
      "approval_description": "恢复指定版本快照中的全部反代规则并立即热重载生效。",
      "summary": "将反代站点配置回滚到指定历史快照并热重载",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/ingress.rollback.request.json",
      "response_schema": "schemas/ingress.rollback.response.json"
    },
    {
      "name": "ingress.upstream.probe",
      "api_version": "v1",
      "permission": "web.ingress:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "实时探测指定反代站点的上游响应状态与延迟",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        },
        {
          "name": "network.egress",
          "scope": "upstream"
        }
      ],
      "request_schema": "schemas/ingress.id.request.json",
      "response_schema": "schemas/ingress.probe.response.json"
    },
