      "api_version": "v1",
      "permission": "web.ingress:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "plannable": true,
      "timeout_ms": 5000,
      "approval": "ai_confirm",
      "approval_summary": "新增或修改反向代理站点",
      "approval_description": "校验域名、上游地址与安全头防注入规则，写入站点配置并自动留存回滚快照。",
      "summary": "新增或更新反向代理站点规则",
      "capabilities": [
        {
          "name": "state.kv.write",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/ingress.site.upsert.request.json",
      "response_schema": "schemas/ingress.site.upsert.response.json"
    },
