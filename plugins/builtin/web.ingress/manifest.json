      "api_version": "v2",
      "permission": "web.ingress:write",
      "mode": "invoke",
      "effect": "write",
      "risk": "medium",
      "idempotent": true,
      "timeout_ms": 15000,
      "approval": "auto",
      "summary": "从插件私有物化目录核验摘要并原子热重载 SNI TLS 证书",
      "capabilities": [
        {
          "name": "network.listen",
          "scope": "ingress"
        },
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/ingress.tls.reload.request.json",
      "response_schema": "schemas/ingress.tls.reload.response.json"
    },
    {
      "name": "ingress.tls.inspect",
      "api_version": "v2",
      "permission": "web.ingress:read",
      "mode": "invoke",
      "effect": "read",
      "risk": "low",
      "idempotent": true,
      "timeout_ms": 5000,
      "summary": "只读观测指定 TLS 绑定在内置反代 SNI 缓存中的代际与监听状态",
      "capabilities": [
        {
          "name": "state.kv.read",
          "scope": "self"
        }
      ],
      "request_schema": "schemas/ingress.tls.inspect.request.json",
      "response_schema": "schemas/ingress.tls.inspect.response.json"
    }
  ],
  "capabilities": [
    {
      "name": "network.listen",
      "scope": "ingress",
      "reason": "启动零依赖内置 Go 反向代理监听器并支持原子热重载"
    },
    {
      "name": "network.egress",
      "scope": "upstream",
      "reason": "转发代理流量并探测本地或内网业务上游健康状态"
    },
    {
      "name": "state.kv.read",
      "scope": "self",
      "reason": "读取反代站点规则、渲染预览与历史快照"
    },
    {
      "name": "state.kv.write",
      "scope": "self",
      "reason": "保存反代站点、bcrypt BasicAuth 哈希与配置快照"
    }
  ],
  "dependencies": [
    {
      "kind": "plugin",
      "id": "domain.dns",
      "constraint": ">=0.1.0 <1.0.0",
      "required": false
    },
    {
      "kind": "plugin",
      "id": "tls.certificates",
      "constraint": ">=0.1.0 <1.0.0",
      "required": false
    }
  ],
  "state": {
    "schema_version": "1",
    "minimum_rollback_version": "0.1.0",
    "backup_paths": [
      "ingress.db"
    ]
  },
  "config": {
    "schema": "schemas/config.schema.json",
    "hot_apply": true
  },
  "resources": {
    "memory_max_mb": 32,
    "cpu_quota_percent": 15,
    "pids_max": 24,
    "fds_max": 512,
    "disk_max_mb": 128,
    "kv_max_kb": 256
  },
  "ui": {
    "widgets": [
      {
        "id": "sites",
        "title": "反向代理站点",
        "kind": "stat",
        "operation": "ingress.stat.sites",
        "refresh_seconds": 10,
        "size": "s",
        "color": "indigo"
      },
      {
        "id": "upstreams",
        "title": "反代上游健康",
        "kind": "checks",
        "operation": "ingress.checks.upstreams",
        "refresh_seconds": 15,
        "size": "m",
        "color": "green"
      }
    ],
    "entry": "ui/index.html",
    "sandbox": true,
    "connect_sources": [],
    "routes": [
      {
        "path": "/ingress",
        "title": "反向代理",
        "nav": true,
        "permission": "web.ingress:read"
      }
    ]
  }
}
