{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web.ingress plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "preferred_engine": {
      "type": "string",
      "enum": [
        "builtin-go",
        "caddy",
        "nginx"
      ],
      "default": "builtin-go"
    },
    "listen_addr": {
      "type": "string",
      "maxLength": 64,
      "default": ":80",
      "description": "内置 Go 反代 HTTP 监听地址（默认 :80；填 off 关闭）"
    },
    "https_listen_addr": {
      "type": "string",
      "maxLength": 64,
      "default": ":443",
      "description": "内置 Go 反代 HTTPS SNI 监听地址（默认 :443；填 off 关闭）"
    },
    "trusted_proxies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "default": []
    },
    "export_config_path": {
      "type": "string",
      "maxLength": 255,
      "default": "",
      "description": "可选：额外导出配置到当前插件数据目录内的绝对路径（外部 Nginx/Caddy 请在预览页一键复制）"
    }
  }
}
