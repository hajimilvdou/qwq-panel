{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sni_pattern",
    "upstream_addr"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64
    },
    "sni_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "精确域名或一级泛域名（如 www.microsoft.com 或 *.node.example.com）"
    },
    "upstream_addr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "本机回环上游地址（如 127.0.0.1:24443）"
    },
    "enabled": {
      "type": "boolean"
    },
    "notes": {
      "type": "string",
      "maxLength": 256
    }
  }
}
