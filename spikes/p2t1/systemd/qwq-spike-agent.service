#
# P2-T1 spike agent. Runs as an unprivileged system user and is the only
# process allowed to start/stop qwq-spike-plugin@* units (see the polkit rule).
[Unit]
Description=qwq P2-T1 spike agent
After=network.target

[Service]
Type=exec
User=qwq-spike-agent
Group=qwq-spike-agent
ExecStart=/opt/qwq-spike/spike-agent -plugins alpha,beta
Restart=no
KillMode=control-group
TimeoutStopSec=10

# Resource limits: the agent is small, the plugins get the OOM priority.
MemoryMax=64M
MemoryHigh=58M
TasksMax=128
LimitNOFILE=512
OOMScoreAdjust=-200
Environment=GOMEMLIMIT=54MiB

# Sandbox. ProtectProc and ProcSubset are deliberately NOT used: the agent has
# to read /proc/<MainPID>/cgroup and /proc/<MainPID>/status of plugin processes
# that run as different uids.
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
KeyringMode=private

# /run/qwq-spike holds the host sockets, the state files and the plugin socket
# tree. /run/systemd and /run/dbus are only connected to, never written.
ReadWritePaths=/run/qwq-spike
