#
# P2-T1 spike plugin template unit. Every plugin runs under its own dynamic
# uid, in its own cgroup, with the S2 sandbox template applied.
[Unit]
Description=qwq P2-T1 spike plugin %i
After=qwq-spike-agent.service
# The plugin must survive an agent restart, so the agent is not a dependency.
IgnoreOnIsolate=yes

[Service]
Type=exec
DynamicUser=yes
# The per-plugin group owns the host socket directory: it is the only group
# that may traverse /run/qwq-spike/host/<id> and connect to host.sock.
SupplementaryGroups=qwq-spike-p-%i
ExecStart=/opt/qwq-spike/spike-plugin -id %i
Restart=no
KillMode=control-group
TimeoutStopSec=10

# Resource limits. GOMEMLIMIT is ~0.85 x MemoryMax, MemoryHigh ~0.9 x MemoryMax.
MemoryMax=48M
MemoryHigh=43M
TasksMax=32
LimitNOFILE=256
OOMScoreAdjust=500
Environment=GOMEMLIMIT=40MiB

# The short-lived token is delivered through the credential store, never through
# Environment= (which is visible over D-Bus).
LoadCredential=spike-token:/run/qwq-spike/creds/%i.token

# The agent host socket of this plugin is the only one visible to it.
BindPaths=/run/qwq-spike/host/%i:/run/qwq-spike/link

# Sandbox template from the architecture review S2.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
KeyringMode=private
