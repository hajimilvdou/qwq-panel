#
# P2-T1 spike plugin socket unit (scheme A). systemd owns the listening socket,
# sets its owner and mode, and passes the file descriptor to the plugin. The
# plugin therefore needs no filesystem access to its own socket, and no other
# plugin can connect to it.
[Unit]
Description=qwq P2-T1 spike plugin socket %i

[Socket]
ListenStream=/run/qwq-spike/plugin/%i/plugin.sock
SocketUser=qwq-spike-agent
SocketMode=0600
Service=qwq-spike-plugin@%i.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
