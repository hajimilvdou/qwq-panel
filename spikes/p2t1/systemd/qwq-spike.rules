//
// P2-T1 spike polkit rule. The agent may only start, stop, restart and kill
// units whose name matches qwq-spike-plugin@<id>.service or .socket. It cannot
// define unit content, and every other action stays unhandled.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.user !== "qwq-spike-agent") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (!unit || !verb) {
        return polkit.Result.NOT_HANDLED;
    }
    if (!/^qwq-spike-plugin@[a-z0-9-]+\.(service|socket)$/.test(unit)) {
        return polkit.Result.NOT_HANDLED;
    }
    var allowed = ["start", "stop", "restart", "try-restart", "reload", "kill"];
    if (allowed.indexOf(verb) < 0) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.YES;
});
